#!/usr/bin/env python3
"""ilio - tiny Flare-On driver around Codex.

host:      ilio ls | get CHAL | solve CHAL|PATH [-i] [codex args] | auto [codex args] | shell CHAL | submit ID FLAG
container: ilio agent [-i] [codex args] | ilio submit FLAG
"""
import base64, hashlib, json, mmap, os, re, shutil, signal, struct, subprocess, sys, threading, time
from pathlib import Path
from urllib.parse import unquote

ROOT = Path(os.path.realpath(__file__)).parent
IN_CTR = Path("/.dockerenv").exists()
for _l in (ROOT / ".env").read_text().splitlines() if (ROOT / ".env").exists() else []:
    if "=" in _l and not _l.lstrip().startswith("#"):
        _k, _v = _l.split("=", 1); os.environ.setdefault(_k.strip(), _v.strip().strip("'\""))
URL = os.environ.get("CTFD_URL", "https://flare-on13.ctfd.io").rstrip("/")
CHALS = Path(os.environ.get("ILIO_CHALS", ROOT / "chals")).resolve()
IMAGE = os.environ.get("ILIO_IMAGE", "ilio-mini")
WORK = Path("/work")
UA = "Mozilla/5.0 (X11; Linux x86_64) ilio"
EXITS = {"correct": 0, "already_solved": 0, "unverified": 0, "incorrect": 1, "ratelimited": 2}


def log(*a): print("[ilio]", *a, file=sys.stderr, flush=True)


# ---------------------------------------------------------------- CTFd
def ctfd():
    import requests
    s = requests.Session(); s.headers["User-Agent"] = UA
    if os.environ.get("CTFD_TOKEN"):  # CTFd ignores the token unless the request is JSON
        s.headers.update({"Authorization": f"Token {os.environ['CTFD_TOKEN']}", "Content-Type": "application/json"})
        return s
    if not os.environ.get("CTFD_USER"): sys.exit("set CTFD_TOKEN or CTFD_USER/CTFD_PASS in .env")
    nonce = re.search(r'name="nonce"[^>]*value="([^"]+)"', s.get(URL + "/login", timeout=30).text)[1]
    r = s.post(URL + "/login", data={"name": os.environ["CTFD_USER"], "password": os.environ.get("CTFD_PASS", ""),
                                     "nonce": nonce, "_submit": "Submit"}, allow_redirects=False, timeout=30)
    if r.status_code != 302: sys.exit("CTFd login failed")
    s.headers["CSRF-Token"] = re.search(r"csrfNonce['\"]?\s*:\s*['\"]([0-9a-f]+)", s.get(URL + "/challenges", timeout=30).text)[1]
    return s


def api(s, path, body=None):
    for i in range(1 if body is not None else 4):
        try:
            r = s.request("POST" if body is not None else "GET", f"{URL}/api/v1{path}", json=body, allow_redirects=False, timeout=30)
            if r.status_code < 500 or body is not None: break
        except Exception as e:
            r = None; err = str(e)
        time.sleep(2 << i)
    if r is None: return 0, {"message": err}
    if r.is_redirect: return 302, {"message": "auth lost -> " + r.headers.get("location", "")}
    try: return r.status_code, r.json()
    except ValueError: return r.status_code, {"message": r.text[:200]}


def challenges(s):
    code, j = api(s, "/challenges")
    if code != 200: sys.exit(f"CTFd {code}: {j.get('message', j)}")
    return [c for c in j["data"] if c.get("type") != "hidden"]


def find(s, key):
    cs = challenges(s)
    for c in cs:
        if str(c["id"]) == str(key) or c["name"].lower() == str(key).lower(): return c
    hits = [c for c in cs if str(key).lower() in c["name"].lower()]
    if len(hits) == 1: return hits[0]
    sys.exit(f"no unique challenge {key!r}: " + ", ".join(f"{c['id']}:{c['name']}" for c in cs))


def slug(i, name): return f"{int(i):02d}-" + re.sub(r"[^A-Za-z0-9]+", "_", name).strip("_")


def prior_flags():
    f = CHALS / "SOLVES.md"
    return re.findall(r"(\S+@flare-on\.com)", f.read_text()) if f.exists() else []


def extract(f, dst):
    dst.mkdir(parents=True, exist_ok=True)
    if f.suffix.lower() in (".7z", ".zip", ".rar", ".gz", ".xz", ".tar", ".tgz"):
        for pw in ["flare", *reversed(prior_flags()), ""]:
            if subprocess.run(["7z", "x", "-y", f"-p{pw}", f"-o{dst}", str(f)], capture_output=True).returncode in (0, 1): return
        log(f"could not extract {f.name} (tried flare + previous flags)")
    elif not (dst / f.name).exists():
        try: os.link(f, dst / f.name)
        except OSError: shutil.copy2(f, dst / f.name)


def get(s, key):
    c = find(s, key); code, j = api(s, f"/challenges/{c['id']}")
    if code != 200: sys.exit(f"CTFd {code}: {j.get('message', j)}")
    d = j["data"]
    w = CHALS / slug(d["id"], d["name"]); w.mkdir(parents=True, exist_ok=True)
    (w / "challenge.json").write_text(json.dumps(d, indent=1))
    (w / "README.md").write_text(f"# {d['name']} ({d.get('category', '')}, {d.get('value')} pts, id {d['id']})\n\n"
                                 f"{d.get('description', '')}\n{d.get('connection_info') or ''}\n")
    for u in d.get("files", []):
        f = w / unquote(u.split("?")[0].rsplit("/", 1)[-1])
        if not f.exists():
            log(f"downloading {f.name}")
            with s.get(URL + u, stream=True, timeout=60) as r:
                r.raise_for_status(); tmp = f.with_name(f.name + ".part")
                with open(tmp, "wb") as o:
                    for b in r.iter_content(1 << 20): o.write(b)
                n = r.headers.get("content-length")
                if n and r.raw.tell() != int(n): raise IOError(f"{f.name}: truncated download ({r.raw.tell()}/{n} B)")
            tmp.rename(f)
        extract(f, w / "src")
    return w


def submit(args):
    flag = args[-1].strip(); cid = args[0] if len(args) > 1 else os.environ.get("ILIO_CHAL_ID", "")
    if not re.fullmatch(r"\S+@flare-on\.com", flag):
        print("REJECTED LOCALLY: Flare-On flags end with @flare-on.com"); return 3
    w = WORK if IN_CTR else Path(".")
    if os.environ.get("ILIO_LOCAL"):  # offline eval: check against the known answer if we have one
        exp = os.environ.get("ILIO_EXPECT", "")
        status = "unverified" if not exp else ("correct" if hashlib.sha256(flag.encode()).hexdigest() == exp else "incorrect")
        msg = ""
    else:
        stamp = w / ".last_submit"
        if stamp.exists(): time.sleep(max(0, 7 - (time.time() - stamp.stat().st_mtime)))
        for i in range(6):  # launch-time overload: retry transport/5xx/login errors; never let them look like "incorrect"
            stamp.touch()
            try: code, j = api(ctfd(), "/challenges/attempt", {"challenge_id": int(cid), "submission": flag})
            except (SystemExit, Exception) as e: code, j = 0, {"message": f"login failed: {e!r}"}
            if (j.get("data") or {}).get("status") or code == 429: break
            log(f"submit: CTFd {code} {str(j.get('message', ''))[:120]}; retry {i + 1}/6"); time.sleep(min(60, 5 << i))
        d = j.get("data") or {}
        status = d.get("status") or ("ratelimited" if code == 429 else f"error-{code}")
        msg = d.get("message", j.get("message", ""))
    with open(w / "submissions.log", "a") as o: o.write(f"{time.strftime('%H:%M:%S')} {status} {flag}\n")
    if EXITS.get(status) == 0: (w / "FLAG").write_text(flag + "\n")
    print(status, msg, "-> STOP NOW, you are done." if EXITS.get(status) == 0 else "")
    return EXITS.get(status, 3)


# ---------------------------------------------------------------- host side
def local(p):
    """FO12-style offline challenge: a .7z/file/dir; known answers in private/FLAREON-12/flags.txt ('N flag')."""
    m = re.match(r"(\d+)", p.name); n = m[1] if m else "0"
    w = CHALS / ("local-" + slug(n, re.sub(r"^\d+\s*-\s*|\.7z$", "", p.name))); w.mkdir(parents=True, exist_ok=True)
    if not (w / "src").exists():
        if p.is_dir(): shutil.copytree(p, w / "src")
        else: extract(p, w / "src")
    if not (w / "README.md").exists():
        (w / "README.md").write_text(f"# {p.name}\n\nFlare-On challenge. Handout extracted to /work/src.\n")
    flags = ROOT / "private/FLAREON-12/flags.txt"
    exp = dict(l.split(None, 1) for l in flags.read_text().split("\n") if l.strip()) if flags.exists() else {}
    e = {"ILIO_LOCAL": "1", "ILIO_EXPECT": hashlib.sha256(exp[n].strip().encode()).hexdigest() if n in exp else ""}
    return w, "", e, ["-c", 'web_search="disabled"']


def preflight():
    try:
        tok = json.load(open(Path.home() / ".codex/auth.json"))["tokens"]["access_token"].split(".")[1]
        left = (json.loads(base64.urlsafe_b64decode(tok + "==="))["exp"] - time.time()) / 3600
        if left < 24: log(f"WARNING: codex access token expires in {left:.1f} h - run `codex login` on the host")
    except Exception as e:
        log(f"WARNING: cannot read ~/.codex/auth.json ({e})")


def docker_cmd(w, cid, env, tty):
    CHALS.mkdir(parents=True, exist_ok=True); solves = CHALS / "SOLVES.md"; solves.touch()
    cmd = ["docker", "run", "--rm", "--init", "--name", "ilio-" + w.name.lower(), "--cap-add", "SYS_PTRACE",
           "--security-opt", "seccomp=unconfined", "--shm-size", "2g", "--memory", os.environ.get("ILIO_MEM", "96g"),
           "-v", f"{Path.home()}/.codex/auth.json:/root/.codex/auth.json", "-v", f"{w}:/work", "-v", f"{w}/.sessions:/root/.codex/sessions",
           "-v", f"{solves}:/solves.md:ro", "-e", f"ILIO_CHAL_ID={cid}", "-e", f"HOST_UID={os.getuid()}:{os.getgid()}"]
    if (ROOT / ".env").exists(): cmd += ["--env-file", str(ROOT / ".env")]
    for k, v in env.items(): cmd += ["-e", f"{k}={v}"]
    cmd += ["-v", f"{ROOT / 'ilio'}:/usr/local/bin/ilio:ro"]  # live edits reach the agent without a rebuild
    for f in ("AGENTS.md", "hooks.json", "stop.sh", "nudge.py"): cmd += ["-v", f"{ROOT / 'codex' / f}:/root/.codex/{f}:ro"]
    for d in (ROOT / "skills").iterdir(): cmd += ["-v", f"{d}:/root/.agents/skills/{d.name}:ro"]
    if os.environ.get("ILIO_PRIVILEGED"): cmd += ["--privileged"]  # mount disk images, loop devs, binfmt, kvm
    if os.environ.get("ILIO_KUNA_DEV"): cmd += ["-v", f"{os.environ['ILIO_KUNA_DEV']}:/opt/kuna-dev:ro", "-e", "ILIO_KUNA_DEV=1"]
    return cmd + (["-it"] if tty and sys.stdin.isatty() else ["-i"] if tty else []) + [IMAGE]


def solve(argv, s=None):
    tui = "-i" in argv; argv = [a for a in argv if a != "-i"]
    key, extra = argv[0], argv[1:]
    if Path(key).exists():
        w, cid, env, x = local(Path(key).resolve()); extra = x + extra
    else:
        s = s or ctfd(); w = get(s, key); cid, env = json.loads((w / "challenge.json").read_text())["id"], {}
    preflight(); (w / "FLAG").unlink(missing_ok=True)
    name = "ilio-" + w.name.lower(); t0 = time.time()
    subprocess.run(["docker", "rm", "-f", name], capture_output=True)  # a stale container would block --name
    proc = subprocess.Popen(docker_cmd(w, cid, env, tui) + ["ilio", "agent"] + (["-i"] if tui else []) + extra)
    def watch():  # the flag is in: stop the container right away (auto moves on to the next challenge)
        while proc.poll() is None:
            if (w / "FLAG").exists():
                time.sleep(20); subprocess.run(["docker", "stop", "-t", "5", name], capture_output=True); return
            if time.time() - t0 > float(os.environ.get("ILIO_TIMEOUT_H", "24")) * 3600:
                log(f"{w.name}: ILIO_TIMEOUT_H reached, stopping"); subprocess.run(["docker", "stop", "-t", "5", name], capture_output=True); return
            if time.time() - t0 > 5400 and not getattr(watch, "warned", 0):
                watch.warned = 1; log(f"\aWARNING: {w.name} running for 90 min - consider steering (stop auto, then ilio solve {key} -i)")
            time.sleep(2)
    threading.Thread(target=watch, daemon=True).start(); proc.wait()
    flag = (w / "FLAG").read_text().strip() if (w / "FLAG").exists() else ""
    r = json.loads((w / "result.json").read_text()) if (w / "result.json").exists() else {}
    with open(CHALS / "results.tsv", "a") as o:
        o.write(f"{time.strftime('%F %T')}\t{w.name}\t{time.time() - t0:.0f}\t{r.get('first_s', '')}\t{r.get('tokens', '')}\t{flag}\n")
    if flag and not w.name.startswith("local-"):
        with open(CHALS / "SOLVES.md", "a") as o: o.write(f"- {w.name}: {flag}\n")
    log(f"{w.name}: {'FLAG ' + flag if flag else 'no flag'} after {time.time() - t0:.0f}s"); return flag


def login_retry():
    while True:
        try: return ctfd()
        except (SystemExit, Exception) as e: log(f"login failed ({e!r}); retrying"); time.sleep(3)


def auto(argv):
    s = login_retry()
    while True:
        code, j = api(s, "/challenges")
        if code == 302:
            if "/confirm" in j.get("message", ""): log("\aCTFd says the account EMAIL IS UNCONFIRMED - click the confirmation email!"); time.sleep(30)
            s = login_retry(); continue
        if code != 200:
            if "/confirm" in str(j.get("message", "")): log("\aCTFd wants email confirmation - confirm the account email!"); time.sleep(30)
            elif int(time.time()) % 30 == 0: log(f"waiting ({code}: {j.get('message', '')})")
            time.sleep(1); continue
        todo = [c for c in j["data"] if c.get("type") != "hidden" and not c.get("solved_by_me")]
        if not todo: log("nothing unsolved is visible; polling"); time.sleep(5); continue
        c = min(todo, key=lambda c: c["id"]); log(f"==> {c['id']}: {c['name']}")
        t1 = time.time()
        try:
            if solve([str(c["id"])] + argv, s): continue
        except (SystemExit, Exception) as e:  # transient CTFd/download errors must not kill auto
            log(f"\asolve failed: {e!r}; retrying"); time.sleep(5); continue
        for h in CHALS.glob(f"{int(c['id']):02d}-*/HELP.md"):
            log(f"\aAgent asked for help: {h} -- fix it, delete HELP.md, and auto resumes")
            while h.exists(): time.sleep(5)
        fast = time.time() - t1 < 300
        log(f"\aNo flag; retrying with a fresh agent{' in 10 min (run died fast: limits?)' if fast else ''}"); time.sleep(600 if fast else 5)


# ---------------------------------------------------------------- container side
SIGS = [(b"MEI\x0c\x0b\x0a\x0b\x0e", "PyInstaller bundle -> $python-re (pyinstxtractor-ng)"), (b"mscoree.dll", ".NET? (mscoree) -> ilspycmd"),
        (b"UPX!", "UPX packed -> kuna unpack"), (b"AU3!EA06", "AutoIt script -> autoit-ripper"), (b"Nuitka", "Nuitka-compiled Python"),
        (b"Go build", "Go binary"), (b"twinBASIC", "twinBASIC app"), (b"MSVBVM60", "VB6 app"), (b"Qt6Core", "Qt6 app"),
        (b"Qt5Core", "Qt5 app"), (b"app.asar", "Electron app -> asar extract"), (b"/rustc/", "Rust binary")]


def triage(src):
    lines, native = [], []
    for f in sorted(p for p in src.rglob("*") if p.is_file())[:200]:
        ft = subprocess.run(["file", "-b", str(f)], capture_output=True, text=True).stdout.strip()
        hints = []
        with open(f, "rb") as fh:
            mm = mmap.mmap(fh.fileno(), 0, access=mmap.ACCESS_READ) if f.stat().st_size else b""
            for sig, h in SIGS:
                i = mm.rfind(sig, max(0, len(mm) - (64 << 20)))
                if i < 0: i = mm.find(sig, 0, 64 << 20)
                if i >= 0 and sig.startswith(b"MEI") and len(mm) >= i + 24: h += f" pyver={struct.unpack('!i', mm[i + 20:i + 24])[0]}"
                if i >= 0: hints.append(h)
            if len(mm) > 0x40 and mm[:2] != b"MZ":
                e = struct.unpack("<I", mm[0x3c:0x40])[0]
                if mm[e:e + 4] == b"PE\0\0":
                    fx = f.with_name(f.stem + ".fixed.exe"); fx.write_bytes(b"MZ" + mm[2:]); hints.append(f"CORRUPTED MZ header -> repaired copy {fx.name}")
        lines.append(f"- {f.relative_to(src)} ({f.stat().st_size} B): {ft}" + ("".join(f"\n  - {h}" for h in hints)))
        if re.search(r"PE32|ELF", ft) and not re.search(r"Mono/\.Net|PyInstaller|pyver", ft + " ".join(hints)) \
                and f.stat().st_size < 30 << 20 and "fixed.exe" not in f.name:
            native.append(f)
    if native:  # prefetch one Kuna export (the main target) while the model reads the prompt
        f = min(native, key=lambda p: (p.suffix.lower() == ".dll", -p.stat().st_size))
        out = WORK / "kuna" / f.name; out.parent.mkdir(exist_ok=True)
        subprocess.Popen(["nice", "-n", "10", "kuna", "decompile-project", str(f), "--stream", "--jobs", "8", "--max-fn-seconds", "10",
                          "-o", str(out)], stdout=open(str(out) + ".log", "w"), stderr=subprocess.STDOUT, start_new_session=True)
        lines.append(f"\nKuna export of `{f.name}` started in the background -> /work/kuna/{f.name}/ (log {out}.log)")
    return "\n".join(lines)


CYBER_NOTE = ("\n\nNOTE: an earlier session on this sanctioned Flare-On CTF puzzle was cut off by a content filter. Your earlier "
              "files and /work/notes.md are in /work: continue from them. Frame your work as analyzing the puzzle's logic to "
              "recover its flag, and avoid rebuilding anything that resembles deployable malware functionality.")


def agent(argv):
    tui = "-i" in argv; extra = [a for a in argv if a != "-i"]
    if os.environ.get("ILIO_KUNA_DEV"):
        os.environ["PATH"] = "/opt/kuna-dev/decompiler/target/release:" + os.environ["PATH"]
        subprocess.run(["kuna", "install-skill", "--dir", "/root/.agents/skills", "--force"], capture_output=True)
    signal.signal(signal.SIGTERM, lambda *_: (subprocess.run(["chown", "-R", os.environ.get("HOST_UID", "0:0"), str(WORK)]), sys.exit(0)))
    for x in (".stops", ".nudge10", ".nudge30", "result.json"): (WORK / x).unlink(missing_ok=True)  # fresh agent, fresh state
    (WORK / ".start").write_text(str(time.time()))
    try: tri = triage(WORK / "src")
    except Exception as e: tri = f"(triage crashed: {e!r}; inspect /work/src yourself)"
    (WORK / "triage.md").write_text(tri + "\n")
    prompt = (f"{(WORK / 'README.md').read_text()}\n## Triage (/work/triage.md)\n{tri}\n\n"
              "Previous solves: /solves.md. Use $flareon and $kuna-decompiler. Solve this challenge now and submit the flag with `ilio submit 'FLAG'`.")
    flags = ["--dangerously-bypass-approvals-and-sandbox", *extra]
    if tui:
        root = (WORK / ".root").read_text().strip() if (WORK / ".root").exists() else ""
        os.execvp("codex", ["codex", "resume", "--dangerously-bypass-hook-trust", *flags, root] if root else
                  ["codex", "--dangerously-bypass-hook-trust", *flags, prompt])
    t0, tid, first, tokens, ncyber, model = time.time(), None, None, 0, 0, []
    budget = float(os.environ.get("ILIO_BUDGET_H", "8")) * 3600
    base = ["--skip-git-repo-check", "--dangerously-bypass-hook-trust", "--json", *flags]
    for n in range(int(os.environ.get("ILIO_RESUMES", "12")) + 1):
        if tid is None:  # fresh thread (first run, or after a cyber-filter block so the flagged context is dropped)
            cmd, inp = ["codex", "exec", *base, *model, "-"], prompt + (CYBER_NOTE if ncyber else "")
        else:
            cmd = ["codex", "exec", "resume", *base, *model, "-c", "model_reasoning_effort=\"xhigh\"", tid, "-"]
            inp = "You stopped without a correct flag. Re-read /work/notes.md, pick the most promising unexplored lead, and keep going."
        fatal = cyber = False; pause = 0
        p = subprocess.Popen(cmd, stdin=subprocess.PIPE, stdout=subprocess.PIPE, text=True, cwd=WORK)
        p.stdin.write(inp); p.stdin.close()
        with open(WORK / "log.jsonl", "a") as lg:
            for line in p.stdout:
                lg.write(line); lg.flush()
                if re.search(r'"type":"(error|turn.failed)"', line) and re.search(r"cyber|routed to|usage", line, re.I):
                    log("\aWARNING (policy/limits):", line.strip()[:300])
                try: ev = json.loads(line)
                except ValueError: continue
                t, it = ev.get("type", ""), ev.get("item") or {}
                if t == "thread.started" and not tid: tid = ev.get("thread_id"); (WORK / ".root").write_text(tid)
                if t == "turn.failed":
                    if "cyber" in line.lower(): cyber = True
                    elif re.search(r"refresh.token|unauthori|log ?in again|sign in", line, re.I): fatal = True
                    else: pause = 900 if re.search(r"usage limit|try again at", line, re.I) else 30
                    log("\aCODEX TURN FAILED:", line.strip()[:300])
                if t.startswith("item.") and it.get("type") != "error" and first is None: first = time.time() - t0
                if t == "turn.completed": tokens += sum(v for v in (ev.get("usage") or {}).values() if isinstance(v, int))
                if t == "item.completed" and it.get("type") == "agent_message": log("agent:", it.get("text", "")[:400])
                if t == "item.started" and it.get("type") == "command_execution": log("$", it.get("command", "")[:200])
        p.wait()
        if fatal: (WORK / "HELP.md").write_text("codex auth failed: run `codex login` on the host, then delete this file\n")
        if (WORK / "FLAG").exists() or (WORK / "HELP.md").exists() or time.time() - t0 > budget or fatal: break
        if cyber:
            ncyber += 1; tid = None
            if ncyber >= 2: model = ["-m", os.environ.get("ILIO_FALLBACK_MODEL", "gpt-daybreak-blue-latest"), "-c", 'service_tier="default"']
            log(f"cyber filter blocked the turn ({ncyber}x); fresh thread{' on ' + model[1] if model else ''}")
            continue
        if tid is None: break
        if pause: log(f"transient codex failure; pausing {pause}s then resuming"); time.sleep(pause)
        log(f"codex exited without a flag (rc={p.returncode}); resuming {tid} ({n + 1})")
    (WORK / "result.json").write_text(json.dumps({"wall_s": round(time.time() - t0), "first_s": round(first or 0), "tokens": tokens, "thread": tid}))
    subprocess.run(["chown", "-R", os.environ.get("HOST_UID", "0:0"), str(WORK)], capture_output=True)


def main():
    a = sys.argv[1:]
    if not a or a[0] in ("-h", "--help"): print(__doc__); return
    cmd, rest = a[0], a[1:]
    if cmd == "ls":
        for c in challenges(ctfd()): print(f"{c['id']:>4} {'*' if c.get('solved_by_me') else ' '} {c['name']}  [{c.get('category', '')}] {c.get('value')}")
    elif cmd == "get": print(get(ctfd(), rest[0]))
    elif cmd == "submit": sys.exit(submit(rest))
    elif cmd == "solve": solve(rest)
    elif cmd == "auto": auto(rest)
    elif cmd == "agent": agent(rest)
    elif cmd == "shell":
        w = Path(rest[0]).resolve() if Path(rest[0]).exists() else CHALS / rest[0]; name = "ilio-" + w.name.lower()
